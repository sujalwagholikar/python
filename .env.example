# ============================================================================
# J.A.R.V.I.S. — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit your actual .env file with real keys to version control.
#
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# ============================================================================


# ----------------------------------------------------------------------------
# GEMINI API KEY  [REQUIRED for Visual UI Understanding + Autonomous Planning]
# ----------------------------------------------------------------------------
# Used by:
#   gemini_vision.py     — Visual understanding of phone screenshots
#   autonomous_planner.py — Structured task decomposition
#   task_agent.py (VisualTaskAgent) — Vision-guided step decisions
#
# Model: gemini-2.5-flash-lite (fast, cheap, multimodal — sees screenshots)
#
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: generous daily quota, sufficient for heavy automation use.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# Optionally override the Gemini model (default: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite


# ----------------------------------------------------------------------------
# GROQ API KEY  [REQUIRED for voice/chat brain + text parser]
# ----------------------------------------------------------------------------
# Used by:
#   jarvis_brain.py  — Conversational JARVIS personality (llama-3.3-70b)
#   llm_parser.py    — Natural language → intent JSON (llama-3.1-8b-instant)
#   task_agent.py (TaskAgent fallback) — Text-only Groq task execution
#
# Get a free key at: https://console.groq.com/keys
# Both keys below are accepted (priority: GROQ_API_KEY_JARVIS > GROQ_API_KEY)
# ----------------------------------------------------------------------------
GROQ_API_KEY_JARVIS=your-groq-api-key-here
# GROQ_API_KEY=your-groq-api-key-here     # alternative variable name


# Optionally override Groq models:
# GROQ_MODEL_JARVIS=llama-3.3-70b-versatile    # brain/narrator model
# GROQ_MODEL_PARSER=llama-3.1-8b-instant        # fast JSON intent parser


# ----------------------------------------------------------------------------
# TAVILY API KEY  [OPTIONAL — for better web search results]
# ----------------------------------------------------------------------------
# If set, web_search.py adds Tavily results alongside DuckDuckGo + Google News.
# Without it, search still works via the two keyless sources.
# Get a free key at: https://app.tavily.com/
# ----------------------------------------------------------------------------
# TAVILY_API_KEY=your-tavily-api-key-here


# ----------------------------------------------------------------------------
# PHONE UNLOCK PIN  [OPTIONAL — only if your phone has a numeric PIN lock]
# ----------------------------------------------------------------------------
# If set, "unlock my phone" will type this PIN after swiping up.
# LEAVE BLANK if your phone has no lock, pattern lock, or biometric lock.
# WARNING: Store this carefully. Don't commit a real PIN to version control.
# ----------------------------------------------------------------------------
# PHONE_UNLOCK_PIN=1234
